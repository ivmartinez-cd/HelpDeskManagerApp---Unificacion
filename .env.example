# =============================================================================
# HelpDesk Manager (unificado) — .env.example
# =============================================================================
# Borrador de Fase 1 (relevamiento). Consolida las variables de las 5 apps
# hijas + el padre, agrupadas por módulo de dominio según ARCHITECTURE_GUIDE.md
# §2 (domain/insumos, domain/liquidaciones, domain/vacaciones,
# domain/parque-impresoras, domain/stc). Nombres definitivos se confirman en
# Fase 2 al diseñar el esqueleto real del backend — esto es el inventario, no
# el contrato final. Ningún valor acá es un secreto real (ver ARCHITECTURE_GUIDE
# §8 — nunca commitear secretos).
#
# Fuentes leídas (.env.example / equivalente de cada repo, 2026-08-06):
#   SDSInsumos/.env.example
#   Calendario web/backend/.env.example, Calendario web/frontend/.env.example
#   Liquidacion-Prestadores/backend/.env.example
#   Printer-Logs-Analyzer/.env.example
#   STC cloud/.env.production.example
#   HelpDeskManager-Web/docker-compose.yml (padre, no tenía .env.example propio)
# =============================================================================

# ===== Núcleo =====
ENVIRONMENT=development
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Deploy objetivo: Portainer / red corporativa, sin exposición pública (ver
# INTEGRACION_APPS_PLAN.md §2 "Deploy"). FRONTEND_URL/CORS_ORIGIN apuntan al
# dominio local del proxy inverso, no a Vercel.
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Leída server-side en frontend/src/app/(app)/layout.tsx: ícono de WATI en
# el header, visible en toda la app. Vacía = el ícono no se muestra.
WATI_URL=

# ===== WATI — módulo wati (chats de WhatsApp esperando respuesta) =====
# Polling de solo lectura contra la API V1 de WATI (sin webhook: IT no expone URL
# pública). Token: Connector → API → Create API Token, scopes contacts:read y
# conversations:read, CON fecha de vencimiento. Tenant = el número del path del
# Team Inbox (https://live-XXXX.wati.io/XXXX/teamInbox → XXXX).
WATI_API_BASE_URL=https://live-mt-server.wati.io
WATI_TENANT_ID=
WATI_API_TOKEN=
# Cada cuántos minutos sincronizar (rate limit de WATI: 10 req / 10 s).
WATI_POLL_INTERVAL_MINUTES=3
# Nombre exacto de operador (operatorName de WATI) al que se restringe la card de
# pendientes — replica "Asignado a mí" del Team Inbox, que no existe en la API
# pública. Vacío = sin filtro (todo el tenant, incluidos otros operadores).
WATI_OPERADOR_FILTRO=

# ===== Base de datos =====
# Postgres consolidado, autoalojado en contenedor (Portainer) — NO Neon.
# Reemplaza: SQLite de SDSInsumos y Liquidacion-Prestadores, Prisma de
# VacaSync (postgresql://vacasync:vacasync@localhost:5432/vacasync), Postgres
# de Printer-Logs-Analyzer (ya self-hosted en la VM, sin cambios de motor),
# Postgres+TimescaleDB de STC Cloud.
# Puerto no estándar a propósito (5439, no 5432): en dev conviven varios
# Postgres de las apps hijas en la misma máquina y 5432 ya tuvo choques
# reales (VacaSync vs STC Cloud, ver memoria de proyecto). DB_PORT lo usa
# docker-compose.yml para mapear el puerto del host; DATABASE_URL es lo que
# usa la app corriendo en el host (fuera de Docker) para conectarse — cuando
# el backend también corra containerizado (Etapa 14), el host pasa a ser
# "db" (nombre del servicio), no "localhost".
DB_PORT=5439
DB_TEST_PORT=5440
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=helpdesk
DATABASE_URL=postgresql://helpdesk:CHANGE_ME@localhost:5439/helpdesk

# ===== Auth unificado (primer módulo real del monolito) =====
# Sesión por cookie httpOnly con ID de sesión OPACO (no JWT) — ver
# docs/adr/004-sesion-opaca-por-cookie.md. No hay secreto de firma que rotar:
# la cookie es un identificador aleatorio, el estado vive en user_session.
SESSION_COOKIE_NAME=hdm_session
SESSION_COOKIE_SECURE=false
# Vencimiento deslizante: expira a los N segundos de inactividad.
SESSION_IDLE_TIMEOUT_SECONDS=604800
# Protección CSRF (double-submit): cookie legible + header que debe coincidir
# en todo método mutante.
CSRF_COOKIE_NAME=hdm_csrf
# Costo de argon2id — ver docs/adr/... (pendiente si se documenta aparte) y el
# .env real nunca debe bajar estos valores por debajo del default de la lib.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# ===== SMTP (notificaciones, compartido entre módulos) =====
# Antes duplicado en SDSInsumos (backup diario + alertas) y STC Cloud
# (opcional). Se unifica en un solo bloque de config.
# SMTP_HOST vacío = mailer de consola (solo loguea).
# Dev recomendado: el contenedor `mailpit` del compose (UI en http://localhost:8025):
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_STARTTLS=false  SMTP_USER= / SMTP_PASS= vacíos
# Producción: host real, SMTP_STARTTLS=true (default) y credenciales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=true
SMTP_FROM="HelpDesk Manager <no-reply@cdsa.com.ar>"

# Emails del módulo vacaciones (nueva solicitud → jefes del sector + admins,
# decisión → empleado). Default false: activarlo es una decisión por entorno —
# con SMTP real configurado, true manda mails de verdad a esas cuentas.
VACACIONES_MAIL_ENABLED=false

# =============================================================================
# Módulo: insumos (ex-SDSInsumos)
# =============================================================================
# --- Insight Portal API (HP SDS Manager LATAM) ---
INSIGHT_BASE_URL=https://hp-sds-latam.insightportal.net/PortalAPI
INSIGHT_API_KEY=
INSIGHT_API_SECRET=
# --- SDS Insight PortalWeb (login humano, distinto de las credenciales de API) ---
SDS_PORTAL_BASE_URL=https://hp-sds-latam.insightportal.net
SDS_PORTAL_USERNAME=
SDS_PORTAL_PASSWORD=
# True = simula la baja de equipos offline sin escribir en el PortalWeb.
SDS_DELETE_DRY_RUN=true
# --- Canal Directo / WebAgentes (pedidos SOAP wsAyC) ---
CD_BASE_URL=https://webagentes.canaldirecto.com.ar
CD_USERNAME=
CD_PASSWORD=
CD_ORIGEN_ID=6
CD_MOTIVO_ID=1
CD_SOLICITANTE_APELLIDO=
CD_SOLICITANTE_NOMBRE=
CD_SOLICITANTE_TELEFONO=
CD_SOLICITANTE_EMAIL=
CD_SOLICITANTE_SECTOR=
CD_DESTINATARIO_APELLIDO=
CD_DESTINATARIO_NOMBRE=
CD_DESTINATARIO_TELEFONO=
CD_DESTINATARIO_EMAIL=
CD_DESTINATARIO_SECTOR=
CD_EMPRESA_IDS=
# --- Autocarga y poller ---
AUTOLOAD_MAX_ORDERS_PER_CYCLE=10
INSIGHT_MARK_ACTIONED=false
INSIGHT_STATUS_ON_ORDER=ACTION
POLL_INTERVAL_MINUTES=60
# --- Backup / alertas del módulo ---
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=3
OFFLINE_CHECK_HOUR=4
ALERT_CHECK_MINUTES=15
BACKUP_MAIL_TO=
BACKUP_MAIL_FROM=
ALERT_MAIL_TO=
ALERT_AFTER_FAILURES=3

# =============================================================================
# Módulo: liquidaciones (ex-Liquidacion-Prestadores)
# =============================================================================
# WS_AYC no requiere credenciales (el WS responde igual con y sin auth).
WS_AYC_ENABLED=false
WS_AYC_WSDL_URL=https://wsg.cdsisa.com.ar/wsAyC_server.php?wsdl
WS_AYC_ENDPOINT_URL=https://wsg.cdsisa.com.ar/wsAyC_server.php
WS_AYC_TIMEOUT_SEGUNDOS=30
WS_AYC_MAX_WORKERS=8

# =============================================================================
# Módulo: parque-impresoras (ex-Printer-Logs-Analyzer)
# =============================================================================
# API_KEY (x-api-key) es el esquema viejo — se retira al entrar el auth
# unificado (ver INTEGRACION_APPS_PLAN.md Fase 5, auditoría de endpoints).
# NOTA: INSIGHT_PORTAL_URL/API_KEY/API_SECRET pisan los mismos nombres que en
# el módulo insumos — a confirmar en Fase 2 si son la misma integración HP
# Insight (reutilizar un solo bloque de config) o credenciales distintas.
SDS_WEB_USERNAME=
SDS_WEB_PASSWORD=

# =============================================================================
# Módulo: vacaciones (ex-VacaSync/Calendario-Web)
# =============================================================================
# Sin variables propias adicionales — cubierto por DATABASE_URL + bloque JWT
# del núcleo (la UI de login unificada se porta de acá).

# =============================================================================
# Módulo: stc (ex-STC Cloud)
# =============================================================================
TONER_WARN_PCT=20
TONER_CRITICAL_PCT=10
# PORTAL_ADMIN_USER/PASSWORD eran credenciales hardcodeadas propias de STC
# Cloud — se retiran al entrar la matriz de permisos del auth unificado.
# REDIS_URL: NO SE USA — decisión cerrada (ver INTEGRACION_APPS_PLAN.md §2,
# alertWorker se resuelve con patrón outbox sobre Postgres + APScheduler).

# =============================================================================
# Integraciones ya existentes del padre (HelpDeskManager-Web)
# =============================================================================
SSRS_BASE=http://reportes.cdsa.com.ar:8090
SSRS_DOMAIN=
SSRS_USER=
SSRS_PASSWORD=
WEBAGENTES_USER=
WEBAGENTES_PASS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# ERS (Epson Remote Services) — token vía Playwright headless.
EPSON_ERS_USERNAME=
EPSON_ERS_PASSWORD=
# Gestión (planificación, herramienta Calendario de contadores) — login
# automático (gestion_session_refresher.py) contra gestion.cdsa.com.ar,
# reemplaza el cookie pegado a mano que vencía.
GESTION_WEB_USERNAME=
GESTION_WEB_PASSWORD=
NAS_APP_DIR=/nas_app

# =============================================================================
# Siges/MERCURIO (consulta en vivo — sla, prestadores, contadores, liquidaciones)
# =============================================================================
# SQL Server legacy vía pyodbc (ODBC Driver 18, ya instalado en la imagen del
# backend). Sin SLA_MERCURIO_HOST los endpoints que consultan Siges responden
# 502 con mensaje claro; el resto de la app arranca y funciona igual. Host
# admite "SERVIDOR,puerto" si no es el 1433 default. Driver/encrypt/timeout
# tienen default en settings.py (encrypt apagado: el server no tiene
# certificado confiable y el driver 18 encripta por default).
# El prefijo SLA_ es histórico (sla fue el primer módulo en usarla); es la
# config de MERCURIO para toda la app y no se renombra: integración verificada
# en producción (ver ADR-018).
SLA_MERCURIO_HOST=
SLA_MERCURIO_DATABASE=Siges
SLA_MERCURIO_USER=
SLA_MERCURIO_PASSWORD=
# Tope de consultas simultáneas a MERCURIO de todo el proceso (semáforo del
# runner compartido, ADR-018; default 3 en settings.py):
# MERCURIO_MAX_CONCURRENT=3

# =============================================================================
# wsAyC (SOAP de Canal Directo — insumos y liquidaciones, provider compartido)
# =============================================================================
# Defaults en settings.py = los valores que estaban hardcodeados en los
# gateways (ADR-018); solo definirlos para apuntar a otro entorno.
# WSAYC_WSDL_URL=https://wsg.cdsisa.com.ar/wsAyC_server.php?wsdl
# WSAYC_ENDPOINT=https://wsg.cdsisa.com.ar/wsAyC_server.php
# WSAYC_TIMEOUT_SECONDS=30

# =============================================================================
# Variables agregadas post-Fase 1 (sincronizado contra settings.py, 2026-08-16)
# =============================================================================

# Freno de seguridad de los jobs de fondo (poller de insumos, refresh de SLA,
# snapshots de analisis-log-hp). En dev SIEMPRE true por default: con datos/SMTP
# reales, un job que corre de verdad manda mails a gente real (ver CLAUDE.md,
# incidente 2026-08-12). docker restart NO relee .env — cambiarla requiere
# docker compose up -d --force-recreate backend.
DISABLE_BACKGROUND_JOBS=true
# Apaga SOLO insumos (su poller manda mail real) dejando correr el resto de
# los jobs de sincronización (sla, analisis-log-hp, contadores, liquidaciones,
# wati) cuando DISABLE_BACKGROUND_JOBS=false.
DISABLE_INSUMOS_BACKGROUND_JOBS=true

# --- Contadores: SDS Insight API (cliente registrado propio, distinto del par
# INSIGHT_* de insumos — probado en vivo 2026-08-11) ---
SDS_API_KEY=
SDS_API_SECRET=
# SDS_BASE_URL=https://hp-sds-latam.insightportal.net/PortalAPI
# SDS_TIMEOUT_SECONDS=20
# CONTADORES_OUTPUT_DIR=var/contadores/outputs

# --- Contadores: Epson ERS (token vía Playwright; credenciales más arriba) ---
# EPSON_ERS_BASE_URL=https://www.remote-services.epson.com/prod
# EPSON_ERS_TOKEN_FILE=var/contadores/ers_token.json
# EPSON_ERS_TIMEOUT_SECONDS=15

# --- Contadores: Gestión web (credenciales más arriba) ---
# GESTION_WEB_BASE_URL=http://gestion.cdsa.com.ar
# GESTION_WEB_TIMEOUT_SECONDS=15
# GESTION_SESSION_FILE=var/contadores/gestion_session.json

# --- Liquidaciones: Google Maps (geocoding + distance matrix; key PAGA — el
# tope por corrida es el freno de gasto, ver memoria del proyecto) ---
GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAX_CALLS_PER_RUN=200

# --- Liquidaciones: cadencia del job de fondo que reconcilia las pendientes
# contra AyC (estado, costos/km) — nunca borra, eso queda exclusivo del botón
# manual. Corre bajo DISABLE_BACKGROUND_JOBS igual que los demás jobs. ---
# LIQUIDACIONES_RECONCILIAR_INTERVAL_MINUTES=120

# --- SLA / pendientes / preventivos / analisis-log-hp (defaults en settings.py) ---
# SLA_MERCURIO_DRIVER={ODBC Driver 18 for SQL Server}
# SLA_MERCURIO_ENCRYPT=false
# SLA_MERCURIO_TIMEOUT_SECONDS=30
# SLA_REFRESH_INTERVAL_MINUTES=240
# PENDIENTES_REFRESH_INTERVAL_MINUTES=60
# PENDIENTES_MESES_CORTE=24
# PREVENTIVOS_MESES_ACTIVIDAD=3
# PREVENTIVOS_ZONAS_EXCLUIDAS= (lista separada por coma; default en settings.py)
# ANALISIS_LOG_HP_SNAPSHOT_INTERVAL_MINUTES=720
