#!/usr/bin/env bash
# pre-commit — un solo control local, barato: ruff sobre los .py staged de backend/, dentro
# del contenedor (sintaxis, imports sin usar, etc.).
#
# Tenía además un control de "no commitear trabajo ajeno" que leía el registro de sesiones de
# Claude (.claude/sessions/edits.tsv). Ese registro lo alimentaban hooks que no sobrevivieron a
# la migración de máquina del 2026-09-24, así que el control se sacó: el archivo nunca tenía
# datos y el chequeo era código muerto. Con varias sesiones sobre el mismo checkout, la regla
# sigue valiendo a ojo (`git add` explícito de lo propio, nunca `-A`): ver CLAUDE.md.
#
# Lo que NO corre acá: lint-imports, mypy y los gates §4/§6/§8/§11 — se sacaron el 2026-09-02
# porque tardaban minutos sobre el HDD USB de la máquina anterior y GitHub Actions los corría
# igual en cada push. Desde el 2026-09-24 ya no hay CI (GitHub abandonado, Gitea sin runner),
# así que eso hay que correrlo a mano: `make check` antes de dar por terminado un módulo
# (ver CLAUDE.md).
# Saltear: git commit --no-verify (solo si sabés por qué).
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

BACKEND=helpdesk-manager-backend
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[[ -z "$staged" ]] && exit 0

red()  { printf '\033[31m✘ %s\033[0m\n' "$*"; }
yel()  { printf '\033[33m! %s\033[0m\n' "$*"; }

# --- backend: ruff sobre los .py staged (lint-imports / mypy / gates: make check, a mano) ---
pyfiles=$(grep -E '^backend/.*\.py$' <<<"$staged" | sed 's#^backend/##' | tr '\n' ' ')
if [[ -n "${pyfiles// /}" ]]; then
  if docker exec "$BACKEND" true 2>/dev/null; then
    # shellcheck disable=SC2086
    docker exec "$BACKEND" uv run ruff check $pyfiles || { red "ruff (archivos staged)"; exit 1; }
  else
    yel "pre-commit: el contenedor $BACKEND no responde — salteo ruff (no hay CI que lo corra después)."
  fi
fi
exit 0
