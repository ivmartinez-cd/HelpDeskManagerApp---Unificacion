#!/usr/bin/env bash
# pre-push — solo muestra qué commits se van a subir (para revisar el git log, no pushear a
# ciegas). NO corre ninguna verificación local.
#
# Historia: hasta el 2026-09-02 corría `make check-fast` (lint-imports + ruff + mypy + pytest
# unit + gates sizes/guards). Medido ese día con la máquina ociosa, sobre el HDD USB:
# 42 + 5 + 108 + 101 + 29 s ≈ 5 min por push; con varias sesiones de Claude en paralelo dejaba
# el disco saturado y freezaba las demás terminales (incidentes 2026-09-01 y 2026-09-02). Un
# push no debería poder colgar la máquina: TODO corre en GitHub Actions
# (.github/workflows/ci.yml): lint-imports, ruff, mypy, pytest unit + integración, gates
# §4/§6/§8/§11, eslint, tsc y la suite completa de Playwright. Quien pushea sigue la corrida
# con `make ci` (gh run watch) y arregla si queda rojo — `main` en GitHub puede quedar rojo
# unos minutos, esa es la contrapartida aceptada.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
remote="${1:-origin}"

z40='0000000000000000000000000000000000000000'
ranges=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_sha:-}" || "$local_sha" == "$z40" ]] && continue   # borrado de rama
  if [[ "$remote_sha" == "$z40" ]]; then
    ranges+=("$local_sha")                  # rama nueva: todo su historial
  else
    ranges+=("$remote_sha..$local_sha")
  fi
done
((${#ranges[@]} == 0)) && exit 0

echo "pre-push → $remote. Commits a subir:"
for r in "${ranges[@]}"; do
  git log --oneline --no-decorate "$r" 2>/dev/null | sed 's/^/    /'
done
echo "Verificación completa en GitHub Actions — seguirla con: make ci"
echo
exit 0
