#!/usr/bin/env bash
# pre-push — muestra qué commits se van a subir (para revisar el git log, no pushear a ciegas)
# y corre ruff sobre los .py de backend tocados en ese rango. Nada más.
#
# Historia: hasta el 2026-09-02 corría `make check-fast` (lint-imports + ruff + mypy + pytest
# unit + gates sizes/guards): ≈5 min por push sobre el HDD USB de la máquina anterior, y con
# varias sesiones de Claude en paralelo dejaba el disco saturado y freezaba las demás
# terminales. Se sacó todo de acá porque GitHub Actions lo corría igual en cada push.
#
# 2026-09-24: GitHub quedó abandonado y el Gitea de Canal Directo (único remoto vivo) no tiene
# runner, así que YA NO HAY CI: lo que no se corre en esta máquina no se corre en ningún lado.
# Este hook sigue sin correr la verificación completa — un push no debería poder colgar la
# máquina, y encadenarla acá empuja a `--no-verify` — pero eso significa que `make check` hay
# que correrlo a mano antes de dar por terminado un módulo (ver CLAUDE.md).
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
remote="${1:-origin}"

red()  { printf '\033[31m✘ %s\033[0m\n' "$*"; }
yel()  { printf '\033[33m! %s\033[0m\n' "$*"; }

z40='0000000000000000000000000000000000000000'
ranges=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_sha:-}" || "$local_sha" == "$z40" ]] && continue   # borrado de rama
  if [[ "$remote_sha" == "$z40" ]]; then
    ranges+=("$local_sha")                  # rama nueva: todo su historial
  else
    ranges+=("$remote_sha..$local_sha")
  fi
done
((${#ranges[@]} == 0)) && exit 0

echo "pre-push → $remote. Commits a subir:"
for r in "${ranges[@]}"; do
  git log --oneline --no-decorate "$r" 2>/dev/null | sed 's/^/    /'
done

# --- ruff sobre los .py de backend tocados en el rango (no borrados) ----------------------
pyfiles=$(
  for r in "${ranges[@]}"; do
    git diff --name-only --diff-filter=ACMR "$r" -- 'backend/*.py' 2>/dev/null
  done | sed 's#^backend/##' | sort -u | tr '\n' ' '
)
if [[ -n "${pyfiles// /}" ]]; then
  BACKEND=helpdesk-manager-backend
  if docker exec "$BACKEND" true 2>/dev/null; then
    # shellcheck disable=SC2086
    if ! docker exec "$BACKEND" uv run ruff check $pyfiles; then
      red "pre-push: ruff falló sobre archivos del rango a pushear."
      echo "  Arreglá y volvé a pushear. Saltear (no recomendado): git push --no-verify"
      exit 1
    fi
  else
    yel "pre-push: el contenedor $BACKEND no responde — salteo ruff. CI lo corre igual."
  fi
fi

echo "Recordá: no hay CI. La verificación completa la corrés vos: make check"
echo
exit 0
