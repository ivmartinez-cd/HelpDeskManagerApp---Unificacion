#!/usr/bin/env bash
# pre-push — la puerta antes de GitHub:
#  1) muestra qué commits se van a subir (para revisar el git log, no pushear a ciegas);
#  2) corre `make check` completo (lint-imports + ruff + mypy + pytest, ≈20 s) y bloquea si falla.
#
# El lint/tsc/smoke Playwright de frontend se sacó de acá (2026-09-01): con
# varias sesiones de Claude Code compartiendo la misma máquina, el smoke
# (arranca un `next dev` de test) podía tardar varios minutos bajo
# contención de CPU y freezaba el resto de las terminales — un push no
# debería poder colgar la máquina. Ahora corre en GitHub Actions
# (.github/workflows/ci.yml) de forma async, sin bloquear. La suite
# completa de Playwright y `make test-integration` siguen siendo a mano
# (`PW_PORT=3011 npx playwright test` en frontend/, `make test-integration`)
# al cerrar cambios de API que consume el front o que tocan el modelo de datos.
# Saltear: git push --no-verify (solo si sabés por qué y lo decís).
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
remote="${1:-origin}"

red() { printf '\033[31m✘ %s\033[0m\n' "$*"; }
yel() { printf '\033[33m! %s\033[0m\n' "$*"; }
ok()  { printf '\033[32m✔ %s\033[0m\n' "$*"; }

z40='0000000000000000000000000000000000000000'
ranges=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_sha:-}" || "$local_sha" == "$z40" ]] && continue   # borrado de rama
  if [[ "$remote_sha" == "$z40" ]]; then
    ranges+=("$local_sha")                  # rama nueva: todo su historial
  else
    ranges+=("$remote_sha..$local_sha")
  fi
done
((${#ranges[@]} == 0)) && exit 0

echo "pre-push → $remote. Commits a subir:"
for r in "${ranges[@]}"; do
  git log --oneline --no-decorate "$r" 2>/dev/null | sed 's/^/    /'
done
echo

log=$(mktemp)
if make -s check >"$log" 2>&1; then
  ok "make check (lint-imports, ruff, mypy, pytest)"
else
  red "make check falló — no se pushea:"; tail -30 "$log"; rm -f "$log"; exit 1
fi
rm -f "$log"
exit 0
