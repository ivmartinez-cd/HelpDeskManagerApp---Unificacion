[importlinter:contract:pyodbc-zeep-solo-infrastructure]
name = pyodbc y zeep solo se importan desde infrastructure (plomeria compartida en shared, ADR-018)
type = forbidden
source_modules =
    src.modules.*.domain
    src.modules.*.application
    src.modules.*.presentation
forbidden_modules =
    pyodbc
    zeep
allow_indirect_imports = True

