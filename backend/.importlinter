[importlinter]
root_package = src
include_external_packages = True

[importlinter:contract:auth-domain-no-frameworks]
name = El dominio de auth no importa frameworks
type = forbidden
source_modules =
    src.modules.auth.domain
forbidden_modules =
    fastapi
    sqlalchemy
    pydantic
    argon2
    alembic

[importlinter:contract:contadores-domain-no-frameworks]
name = El dominio de contadores no importa frameworks
type = forbidden
source_modules =
    src.modules.contadores.domain
forbidden_modules =
    fastapi
    sqlalchemy
    pydantic
    alembic

[importlinter:contract:contadores-domain-app-independent-from-auth]
name = El domain/application de contadores no depende de auth (ver ADR-007)
type = forbidden
source_modules =
    src.modules.contadores.domain
    src.modules.contadores.application
forbidden_modules =
    src.modules.auth

[importlinter:contract:auth-independent-from-contadores]
name = auth no depende de contadores (dirección única de la excepción del ADR-007)
type = forbidden
source_modules =
    src.modules.auth
forbidden_modules =
    src.modules.contadores

